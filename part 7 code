#include <stdio.h>
#include <string.h>

// Global Variables
// Shared state variables that must remain available throughout the entire
// program execution
int studentID;
char fullName[50];
float gpa;
char academicStanding[30];
int grades[5];

int hasStudentData = 0;
int hasGrades = 0;

//New Global Variables for Application Statistics
int totalStudentsEntered = 0;
float totalGpaSum = 0.00;
int totalHonorsStudents = 0;

// 1. Function: Displays the startup header
void displayHeader(void) {
  printf("Student Information Management System\n");
  printf("Version 7.0\n");
  printf("Programmer: Alex P. Rodriguez\n");
  printf("Course: COP 3515\n\n");
}

// 2. Function: Displays the main menu and captures user selection
int displayMenu(void) {
  char buffer[100]; // Local variable (temporary storage for input)
  int selection;    // Local variable

  printf("1. Add Student\n");
  printf("2. Display Student\n");
  printf("3. Enter Grades\n");
  printf("4. Save Student Record\n");
  printf("5. Exit\n");
  printf("6. Display Statistics\n");
  printf("Selection: ");

  if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
    if (buffer[0] == '\n' || sscanf(buffer, "%d", &selection) != 1) {
      selection = -1; // Force invalid selection on empty/bad input
    }
  } else {
    selection = -1;
  }

  return selection;
}

// 3. Function: Calculates academic standing based on valid GPA
void determineAcademicStanding(void) {
  if (gpa >= 3.50) {
    strcpy(academicStanding, "Honors");
  } else if (gpa >= 2.00) {
    strcpy(academicStanding, "Good Standing");
  } else if (gpa >= 1.00) {
    strcpy(academicStanding, "Academic Probation");
  } else {
    strcpy(academicStanding, "Academic Suspension");
  }
}

// 4. Function: Prompts user for student data and handles validation
void addStudent(void) {
  char buffer[100]; // Local variable
  int inputStatus;  // Local variable

  printf("Student ID: ");
  for (;;) {
    if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
      if (buffer[0] == '\n') {
        printf("Input cannot be empty. Please enter Student ID: ");
        continue;
      }
      if (sscanf(buffer, "%d", &studentID) == 1)
        break;
      else {
        printf("Invalid input. Please enter a valid Student ID#: ");
      }
    }
  }

  printf("Student Name: ");
  for (;;) {
    if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
      if (buffer[0] == '\n') {
        printf("Input cannot be empty. Please enter Student Full Name: ");
        continue;
      }
      if (sscanf(buffer, "%49[^\n]", fullName) == 1)
        break;
    }
  }

  printf("Current GPA: ");
  for (;;) {
    if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
      if (buffer[0] == '\n') {
        printf("\nERROR\n\n");
        printf("Input cannot be empty.\n");
        printf("Current GPA: ");
        continue;
      }

      inputStatus = sscanf(buffer, "%f", &gpa);

      if (inputStatus == 1 && gpa >= 0.00 && gpa <= 4.00) {
        break;
      } else {
        printf("\nERROR\n\n");
        printf("Invalid GPA entered.\n");
        printf("GPA must be between 0.00 and 4.00.\n");
        printf("Current GPA: ");
      }
    }
  }

  determineAcademicStanding();
  hasStudentData = 1;

  // CCR-007: Update Application Statistics upon successfully adding a student
  totalStudentsEntered++;
  totalGpaSum += gpa;
  if (gpa >= 3.50) {
    totalHonorsStudents++;
  }

  printf("\nStudent successfully added.\n\n");
}

// 5. Function: Prompts user for 5 course grades and handles validation
void enterGrades(void) {
  char buffer[100]; // Local variable
  int inputStatus;  // Local variable
  int i;            // Local variable

  for (i = 0; i < 5; i++) {
    printf("Enter grade for Course %d (0-100): ", i + 1);
    for (;;) {
      if (fgets(buffer, sizeof(buffer), stdin) != NULL) {
        if (buffer[0] == '\n') {
          printf("Input cannot be empty. Please re-enter Course %d grade "
                 "(0-100): ",
                 i + 1);
          continue;
        }

        inputStatus = sscanf(buffer, "%d", &grades[i]);

        if (inputStatus == 1 && grades[i] >= 0 && grades[i] <= 100) {
          break;
        } else {
          printf("Invalid grade. Please re-enter Course %d grade (0-100): ",
                 i + 1);
        }
      }
    }
  }
  hasGrades = 1;
  printf("\nGrades successfully recorded.\n\n");
}

// 6. Function: Calculates and prints the grade averages, highest, and lowest
void calculateGradeStatistics(void) {
  int sum = 0; // Local variable
  int highest = grades[0];
  int lowest = grades[0];
  float average; // Local variable
  int i;         // Local variable

  printf("\nCourse Grades\n");
  for (i = 0; i < 5; i++) {
    printf("%d\n", grades[i]);
    sum += grades[i];
    if (grades[i] > highest)
      highest = grades[i];
    if (grades[i] < lowest)
      lowest = grades[i];
  }

  average = (float)sum / 5.0;
  printf("\nAverage Grade: %.2f\n", average);
  printf("Highest Grade: %d\n", highest);
  printf("Lowest Grade : %d\n", lowest);
}

// 7. Function: Displays the full formatted student report
void displayStudent(void) {
  if (!hasStudentData) {
    printf("\nStudent Data has not been entered yet\n\n");
    return;
  }

  printf("\nStudent Summary\n");
  printf("Student ID : %d\n", studentID);
  printf("Student Name : %s\n", fullName);
  printf("Current GPA : %.2f\n", gpa);
  printf("Academic Standing: %s\n", academicStanding);

  if (hasGrades) {
    calculateGradeStatistics();
  }
  printf("\n");
}

// 8. Function: Writes the student data and grades to a text file
void saveStudentRecord(void) {
  FILE *file; // Local variable
  int i;      // Local variable

  if (!hasStudentData) {
    printf("\nStudent Data has not been entered yet\n\n");
    return;
  }

  file = fopen("student_records.txt", "w");
  if (file != NULL) {
    fprintf(file, "%d\n", studentID);
    fprintf(file, "%s\n", fullName);
    fprintf(file, "%.2f\n", gpa);
    fprintf(file, "%s\n", academicStanding);

    if (hasGrades) {
      for (i = 0; i < 5; i++) {
        fprintf(file, "%d\n", grades[i]);
      }
    }
    fclose(file);
    printf("\nStudent record successfully saved.\n");
    printf("student_records.txt created.\n\n");
  } else {
    printf("\nERROR\nUnable to open student_records.txt\n\n");
  }
}

// 9. Function: Displays the tracked program statistics
void displayStatistics(void) {
  float averageGPA = 0.00; // Local variable

  // Calculate average, protecting against division by zero
  if (totalStudentsEntered > 0) {
    averageGPA = totalGpaSum / totalStudentsEntered;
  }

  printf("\nSIMS Statistics\n");
  printf("Total Students Entered: %d\n", totalStudentsEntered);
  printf("Average GPA           : %.2f\n", averageGPA);
  printf("Honor Students        : %d\n\n", totalHonorsStudents);
}

// 10. Function: Routes the program based on the menu selection
int processMenuSelection(int selection) {
  if (selection == 1) {
    addStudent();
    return 1;
  } else if (selection == 2) {
    displayStudent();
    return 1;
  } else if (selection == 3) {
    enterGrades();
    return 1;
  } else if (selection == 4) {
    saveStudentRecord();
    return 1;
  } else if (selection == 5) {
    printf(
        "\nThank you for using the Student Information Management System.\n");
    printf("Program terminated successfully.\n");
    return 0;
  } else if (selection == 6) {
    displayStatistics();
    return 1;
  } else {
    printf("\nERROR\n\n");
    printf("Invalid menu selection.\n\n");
    printf("Please choose an option between 1 and 6.\n\n");
    return 1;
  }
}

// 11. The Main function (Manager)
int main() {
  int selection;           // Local variable
  int continueRunning = 1; // Local variable

  displayHeader();

  // Continuous execution loop
  while (continueRunning) {
    selection = displayMenu();
    continueRunning = processMenuSelection(selection);
  }

  return 0;
}
